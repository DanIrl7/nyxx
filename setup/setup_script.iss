; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only
;
; Relative paths below are relative to this script (setup\), so the
; installer builds from any checkout. Build Nyxx.exe first:
;   pyinstaller Nyxx.spec        (from the repo root; writes dist\Nyxx.exe)

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{2BD385C9-B54B-4973-AF5E-2BB9E1F3B355}
AppName=Nyxx
AppVersion=1.1
AppPublisher=Danirl7
AppPublisherURL=https://github.com/DanIrl7/nyxx
AppSupportURL=https://github.com/DanIrl7/nyxx
AppUpdatesURL=https://github.com/DanIrl7/nyxx
DefaultDirName={autopf}\Nyxx
UninstallDisplayIcon={app}\Nyxx.exe
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
OutputDir=..\dist
OutputBaseFilename=Nyxx_Setup_1.1
SetupIconFile=..\assets\icon.ico
SolidCompression=yes
WizardStyle=classic zircon
; Tell Explorer the user's PATH changed (see [Registry]). Without this, any
; terminal opened from the Start menu or taskbar keeps the old PATH, and
; `nyxx` isn't found until the user signs out and back in.
ChangesEnvironment=yes
; Install for the current user only ({autopf} becomes %LOCALAPPDATA%\Programs),
; with no admin prompt. Everything else Setup touches is per-user too —
; the user's PATH, PowerShell profile and ~/.bashrc — and an elevated
; install run with another account's admin password would put those in
; that admin's profile instead of the user's.
PrivilegesRequired=lowest

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; Only offered when Windows PowerShell is still on its default Restricted
; policy, which stops it loading the profile that defines `nyxx`. Checked
; by default; add "Flags: unchecked" to make it opt-in.
Name: "pspolicy"; Description: "Let Windows PowerShell run the nyxx command (sets PowerShell's execution policy to RemoteSigned, for your account only)"; GroupDescription: "Windows PowerShell:"; Check: WindowsPowerShellIsRestricted

[Files]
Source: "..\dist\Nyxx.exe"; DestDir: "{app}"; Flags: ignoreversion
; FIXED: Changed DestDir to {app}\assets so backgrounds are unpacked inside 'assets/backgrounds' instead of root!
Source: "..\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs
; The `nyxx` shell commands. cmd.exe finds nyxx.bat through PATH ({app}\shims).
; The PowerShell and Bash versions go in {app}\shell, which is NOT on PATH,
; and are loaded from the shell profiles instead (see CurStepChanged): on
; PATH, PowerShell would pick nyxx.ps1 over nyxx.bat and run it as a script,
; which only defines the function — or, with scripts blocked, fails outright.
; Being regular installed files, they're replaced on every reinstall and
; removed on uninstall.
Source: "shims\nyxx.bat"; DestDir: "{app}\shims"; Flags: ignoreversion
Source: "shell\*"; DestDir: "{app}\shell"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\Nyxx"; Filename: "{app}\Nyxx.exe"; IconFilename: "{app}\assets\icon.ico"
Name: "{autodesktop}\Nyxx"; Filename: "{app}\Nyxx.exe"; Tasks: desktopicon; IconFilename: "{app}\assets\icon.ico"

[Registry]
; {app}\shims is listed *before* {app} itself so cmd.exe finds nyxx.bat
; ahead of Nyxx.exe on PATH — that's what gives cmd.exe a working `nyxx`
; command (see shims\nyxx.bat for why cmd.exe needs this and
; PowerShell/Bash, which get a profile function instead, don't).
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{app}\shims;{olddata};{app}"; Flags: preservestringtype; Check: NotOnPath

[Run]
; A plain cmd.exe window, same as opening Command Prompt yourself —
; nothing auto-run inside it. Nyxx.exe alone (no shell behind it) can't
; act on cd/exec, so the useful "launch" here is landing the user in a
; real terminal where the nyxx command (on PATH via the shim) just works,
; not the app itself starting immediately. The window inherits Setup's own
; environment, from before PATH was changed, so the new entries are added
; to it explicitly.
Filename: "{cmd}"; Parameters: "/k set ""PATH={app}\shims;%PATH%;{app}"""; WorkingDir: "{%USERPROFILE}"; Description: "{cm:LaunchProgram,Nyxx}"; Flags: nowait postinstall skipifsilent

[Code]
// Helper function to check if {app} is already added to the user's Path environment variable
function NotOnPath(): Boolean;
var
  PathStr: String;
begin
  if RegQueryStringValue(HKCU, 'Environment', 'Path', PathStr) then
  begin
    Result := Pos(ExpandConstant('{app}'), PathStr) = 0;
  end
  else
  begin
    Result := True;
  end;
end;

var
  PolicyRead: Boolean;
  CachedPolicy: String;

// Windows PowerShell's effective execution policy ('Restricted', the
// default on Windows 10/11, 'RemoteSigned', ...), or '' if it can't be
// read. Cached, since Check functions get called repeatedly; pass Refresh
// to read it again.
function WindowsPowerShellPolicy(Refresh: Boolean): String;
var
  PolicyFile, QuotedPolicyFile: String;
  Output: AnsiString;
  ResultCode: Integer;
begin
  if Refresh or not PolicyRead then
  begin
    PolicyRead := True;
    CachedPolicy := '';
    PolicyFile := ExpandConstant('{tmp}\nyxx_ps_policy.txt');
    DeleteFile(PolicyFile);
    // Inside a single-quoted PowerShell string only ' needs escaping ('').
    QuotedPolicyFile := PolicyFile;
    StringChangeEx(QuotedPolicyFile, '''', '''''', True);
    if Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
            '-NoProfile -NonInteractive -Command "Get-ExecutionPolicy | Out-File -Encoding ascii -LiteralPath ''' + QuotedPolicyFile + '''"',
            '', SW_HIDE, ewWaitUntilTerminated, ResultCode)
       and (ResultCode = 0) and LoadStringFromFile(PolicyFile, Output) then
    begin
      CachedPolicy := Output;
      CachedPolicy := Trim(CachedPolicy);
    end;
  end;
  Result := CachedPolicy;
end;

// True when Windows PowerShell won't load profile scripts: Restricted or
// AllSigned. If the policy can't be read, assume scripts run, as earlier
// versions of this installer did.
function WindowsPowerShellBlocksScripts(): Boolean;
var
  Policy: String;
begin
  Policy := WindowsPowerShellPolicy(False);
  Result := (CompareText(Policy, 'Restricted') = 0) or (CompareText(Policy, 'AllSigned') = 0);
end;

// Check for the "pspolicy" task. Only the default Restricted policy is
// offered for change: AllSigned is someone's deliberate choice.
function WindowsPowerShellIsRestricted(): Boolean;
begin
  Result := CompareText(WindowsPowerShellPolicy(False), 'Restricted') = 0;
end;

// The "pspolicy" task. CurrentUser scope only, so it doesn't affect other
// accounts and needs no admin rights. Re-reads the policy afterwards:
// Group Policy, if set, still overrides it.
procedure AllowWindowsPowerShellScripts();
var
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
       '-NoProfile -NonInteractive -Command "Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned -Force"',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  WindowsPowerShellPolicy(True);
end;

// Appends Lines to a shell profile unless it already loads our shim (a
// line containing Marker). A profile that defines its own nyxx function
// which this installer didn't write (e.g. a run-from-source setup) is
// left alone. One holding the inline function that installer v1.1 and
// earlier wrote gets the shim line added after it, so the shim's newer
// function overrides that one.
procedure AppendToProfile(ProfilePath: String; Lines: TArrayOfString; Marker: String);
var
  FileLines: TArrayOfString;
  I: Integer;
  HasOwnFunction, HasOldInstallerBlock: Boolean;
begin
  if not FileExists(ProfilePath) then
  begin
    ForceDirectories(ExtractFilePath(ProfilePath));
    SaveStringsToFile(ProfilePath, Lines, False);
    Exit;
  end;

  if not LoadStringsFromFile(ProfilePath, FileLines) then
    Exit;

  HasOwnFunction := False;
  HasOldInstallerBlock := False;
  for I := 0 to GetArrayLength(FileLines) - 1 do
  begin
    if Pos(Marker, FileLines[I]) > 0 then
      Exit;
    if Trim(FileLines[I]) = '# Nyxx Shell Integration' then
      HasOldInstallerBlock := True;
    if (Pos('function nyxx', FileLines[I]) > 0) or (Pos('nyxx() {', FileLines[I]) > 0) then
      HasOwnFunction := True;
  end;

  if HasOwnFunction and not HasOldInstallerBlock then
    Exit;

  SaveStringsToFile(ProfilePath, Lines, True);
end;

// Runs automatically at the end of the installation process
procedure CurStepChanged(CurStep: TSetupStep);
var
  PowerShellLines: TArrayOfString;
  BashLines: TArrayOfString;
  UserHome, ShimPs1, ShimSh: String;
  Profile1, Profile2, BashrcPath, ZshrcPath: String;
begin
  if CurStep = ssPostInstall then
  begin
    // Attempt to resolve home directory (~ or %USERPROFILE%)
    UserHome := GetEnv('USERPROFILE');
    if UserHome = '' then
      UserHome := ExpandConstant('{userdocs}\..'); // Safe fallback to parent of 'Documents' folder

    // The profiles only load the nyxx function from {app}\shell, so a
    // reinstall updates it in place. Each line checks the file exists
    // first, so the profile still loads cleanly after an uninstall.

    // 1. PowerShell. Inside a single-quoted string only ' needs escaping ('').
    ShimPs1 := ExpandConstant('{app}\shell\nyxx.ps1');
    StringChangeEx(ShimPs1, '''', '''''', True);
    SetArrayLength(PowerShellLines, 3);
    PowerShellLines[0] := '';
    PowerShellLines[1] := '# Nyxx Shell Integration';
    PowerShellLines[2] := 'if (Test-Path -LiteralPath ''' + ShimPs1 + ''') { . ''' + ShimPs1 + ''' }';

    // Target profiles for Windows PowerShell (5.1) and PowerShell Core (6+).
    // {userdocs} is wherever Documents really lives (e.g. moved into
    // OneDrive), which is where $PROFILE points.
    Profile1 := ExpandConstant('{userdocs}\WindowsPowerShell\Microsoft.PowerShell_profile.ps1');
    Profile2 := ExpandConstant('{userdocs}\PowerShell\Microsoft.PowerShell_profile.ps1');

    if WizardIsTaskSelected('pspolicy') then
      AllowWindowsPowerShellScripts();

    // While Windows PowerShell blocks scripts, a profile we wrote would only
    // print an error every time it starts, so leave it alone and explain.
    // There, `nyxx` still runs (via shims\nyxx.bat), but it can't change
    // the shell's folder. PowerShell 7 defaults to RemoteSigned, so its
    // profile is set up either way.
    if WindowsPowerShellBlocksScripts() then
    begin
      if not WizardSilent() then
      begin
        if WizardIsTaskSelected('pspolicy') then
          MsgBox('Setup couldn''t let Windows PowerShell run scripts: on this PC that setting ' +
                 'seems to be managed by your organization, so the nyxx command wasn''t added ' +
                 'to your PowerShell profile.' + #13#10#13#10 +
                 'In Windows PowerShell, nyxx will still open, but picking a folder or saved ' +
                 'location won''t change your current directory. Command Prompt and PowerShell 7 ' +
                 'aren''t affected.',
                 mbInformation, MB_OK)
        else
          MsgBox('Windows PowerShell on this PC is set to block scripts, so Setup didn''t add ' +
                 'the nyxx command to your PowerShell profile.' + #13#10#13#10 +
                 'In Windows PowerShell, nyxx will still open, but picking a folder or saved ' +
                 'location won''t change your current directory. Command Prompt and PowerShell 7 ' +
                 'aren''t affected.' + #13#10#13#10 +
                 'To enable it, run this once in PowerShell, then run this installer again:' + #13#10#13#10 +
                 '    Set-ExecutionPolicy -Scope CurrentUser RemoteSigned',
                 mbInformation, MB_OK);
      end;
    end
    else
      AppendToProfile(Profile1, PowerShellLines, 'shell\nyxx.ps1');
    AppendToProfile(Profile2, PowerShellLines, 'shell\nyxx.ps1');

    // 2. Bash/Zsh (Git Bash, MSYS2), which take C:/... style paths.
    ShimSh := ExpandConstant('{app}\shell\nyxx.sh');
    StringChangeEx(ShimSh, '\', '/', True);
    SetArrayLength(BashLines, 3);
    BashLines[0] := '';
    BashLines[1] := '# Nyxx Shell Integration';
    BashLines[2] := 'if [ -f "' + ShimSh + '" ]; then . "' + ShimSh + '"; fi';

    BashrcPath := UserHome + '\.bashrc';
    ZshrcPath := UserHome + '\.zshrc';

    AppendToProfile(BashrcPath, BashLines, 'shell/nyxx.sh');
    AppendToProfile(ZshrcPath, BashLines, 'shell/nyxx.sh');
  end;
end;
